    type xapo_collapsed_panel = widget {
        name = "xapo_collapsed_panel"
        layer = middle
        parentanchor = top|right
        position = { -16 100 }
        size = { 330 44 }
        visible = "[And( And( IsGameViewOpen( 'activity_planner' ), EqualTo_string( ActivityPlanner.GetActivityType.GetKey, 'activity_xapo_potential_output' ) ), GetVariableSystem.Exists( 'xapo_panel_collapsed' ) )]"
        using = Window_Background
        background = { using = Background_Area_Dark }
        hbox = {
            margin = { 8 6 }
            layoutpolicy_horizontal = expanding
            spacing = 6
            button_round = {
                name = "xapo_expand_panel"
                size = { 32 32 }
                down = yes
                tooltip = "xapo_mapmode_tooltip"
                onclick = "[GetVariableSystem.Clear( 'xapo_panel_collapsed' )]"
                button_icon = {
                    size = { 22 22 }
                    parentanchor = center
                    alwaystransparent = yes
                    texture = "gfx/interface/icons/flat_icons/map_modes/production.dds"
                    color = { 0.45 0.9 0.75 1 }
                }
            }
            text_single = {
                text = "xapo_mapmode_title"
                using = Font_Size_Small
            }
            expand = {}
            button_close = {
                name = "xapo_exit_collapsed_map"
                size = { 28 28 }
                shortcut = "close_window"
                tooltip = "xapo_exit"
                onclick = "[CloseGameView( 'activity_planner' )]"
                onclick = "[SetMapMode( Select_CString( GetVariableSystem.Exists( 'xapo_previous_mapmode' ), GetVariableSystem.Get( 'xapo_previous_mapmode' ), 'realms' ) )]"
            }
        }
    }
    type xapo_view_controls = widget {
        size = { 4 4 }
        alwaystransparent = yes
        visible = "[And( IsGameViewOpen( 'activity_planner' ), EqualTo_string( ActivityPlanner.GetActivityType.GetKey, 'activity_xapo_potential_output' ) )]"
        hbox = {
            size = { 8 4 }
            alwaystransparent = yes
            datacontext = "[GetActivityType( 'activity_xapo_potential_output' ).GetOptionCategoryByKey( 'special_type' )]"
            datamodel = "[ActivityOptionCategory.GetOptions]"
            item = {
                widget = {
                    size = { 4 4 }
                    alwaystransparent = yes
                    # Animate a free child; the hbox owns its item's position.
                    widget = {
                        size = { 2 2 }
                        alwaystransparent = yes
                        state = {
                            name = "xapo_refresh_scores"
                            trigger_when = "[And( EqualTo_string( ActivityPlanner.GetActivityType.GetKey, 'activity_xapo_potential_output' ), EqualTo_int32( ActivityOption.GetIndexInCategory, Select_int32( GetVariableSystem.Exists( 'xapo_refresh' ), '(int32)1', '(int32)0' ) ) )]"
                            duration = 0.3
                            position_x = 1
                            on_finish = "[ActivityPlanner.OpenSpecialOptionSelection]"
                            on_finish = "[ActivityPlanner.SelectOption( ActivityOption.Self )]"
                            on_finish = "[ActivityPlanner.StartLocationPicking]"
                        }
                    }
                }
            }
        }
    }
    type xapo_county_potential_icons = flowcontainer {
        name = "xapo_county_potential_icons"
        parentanchor = center
        position = { 0 -30 }
        direction = vertical
        allow_outside = yes
        ignoreinvisible = yes
        visible = "[And( EqualTo_string( ActivityPlannerMapIcon.GetActivityType.GetKey, 'activity_xapo_potential_output' ), And( LessThan_int32( GetZoomLevel, '(int32)10' ), ObjectsEqual( ActivityPlannerMapIcon.GetProvince, ActivityPlannerMapIcon.GetProvince.GetCountyCapitalProvince ) ) )]"
        datacontext = "[ActivityPlannerMapIcon.GetProvince.GetCounty]"
        datacontext = "[GuiScope.SetRoot( County.GetTitle.MakeScope ).AddScope( 'host', GetPlayer.MakeScope )]"

        text_single = {
            raw_text = "[County.GetTitle.GetNameNoTooltip] ([TopScope.ScriptValue( 'xapo_selected_potential_count' )|0])"
            using = Font_Size_Small
        }

        flowcontainer = {
            name = "xapo_filtered_potential_goods"
            datamodel = "[County.GetPotentialTradeGoodTypes]"
            wrap_count = 6
            spacing = 1
            ignoreinvisible = yes
            item = {
                icon = {
                    name = "xapo_potential_good"
                    visible = "[Not( GetVariableSystem.HasValue( Concatenate( 'xapo_hidden_', TradeGoodType.GetTextIconNoFormat ), 'yes' ) )]"
                    size = { 26 26 }
                    texture = "[TradeGoodType.GetSmallIcon]"
                    tooltipwidget = trade_good_type_tooltip
                    using = tooltip_ne
                    background = { using = Background_Area_Dark }
                }
            }
        }
    }
}
