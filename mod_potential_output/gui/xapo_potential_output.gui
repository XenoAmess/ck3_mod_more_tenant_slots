    type xapo_host_intro = vbox {
        using = Window_Margins
        spacing = 20
        visible = "[EqualTo_string( ActivityListDetailHostView.GetType.GetKey, 'activity_xapo_potential_output' )]"
        state = {
            name = "xapo_enter_potential_map_a"
            trigger_when = "[And( GetVariableSystem.HasValue( 'xapo_entry_cycle', 'yes' ), EqualTo_string( ActivityListDetailHostView.GetType.GetKey, 'activity_xapo_potential_output' ) )]"
            duration = 0.3
            on_finish = "[ActivityListDetailHostView.Confirm]"
        }
        state = {
            name = "xapo_enter_potential_map_b"
            trigger_when = "[And( Not( GetVariableSystem.HasValue( 'xapo_entry_cycle', 'yes' ) ), EqualTo_string( ActivityListDetailHostView.GetType.GetKey, 'activity_xapo_potential_output' ) )]"
            duration = 0.3
            on_finish = "[ActivityListDetailHostView.Confirm]"
        }
        header_pattern = {
            layoutpolicy_horizontal = expanding
            blockoverride "header_text" { text = "xapo_potential_output" }
            blockoverride "button_close" { onclick = "[ActivityListDetailHostView.Close]" }
        }
        text_multi = {
            text = "xapo_potential_output_desc"
            max_width = 550
            autoresize = yes
        }
        button_primary = {
            name = "xapo_show_map"
            size = { 380 50 }
            text = "xapo_show_map"
            onclick = "[ActivityListDetailHostView.Confirm]"
        }
    }
